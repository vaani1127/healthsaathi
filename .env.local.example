# Native mode (make demo-native) with a Neon Postgres database. Copy to .env.local (gitignored)
# and fill in the values from the Neon console. Never commit the filled file.
#
# Pooled connection string (host contains "-pooler"), used by the api and the worker.
# Use the postgresql:// form from Neon; sslmode=require is kept.
DATABASE_URL=
# Direct connection string (no "-pooler"), used for migrations (Alembic) and the seed.
DATABASE_DIRECT_URL=
# Direct connection string of the Neon branch "test", used by the smoke tests.
TEST_DATABASE_URL=
