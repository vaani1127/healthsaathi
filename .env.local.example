# Native mode (make demo-native) with a Neon Postgres database. Copy to .env.local (gitignored)
# and fill in the connection strings from the Neon console. Never commit the filled file.
# Use the postgresql:// form Neon shows; sslmode=require is kept.
#
# Main branch, pooled (host contains "-pooler"): used by the api.
CONNECT_CONNECTION_POOLING_ON=
# Main branch, direct: used for migrations, the seed and the worker.
CONNECT_CONNECTION_POOLING_OFF=
# Branch "test", direct: used by the smoke tests.
TEST_BRANCH_CONNECTION_POOLING_OFF=
# Branch "test", pooled: optional, to check the api against the pooler.
TEST_BRANCH_CONNECTION_POOLING_ON=
