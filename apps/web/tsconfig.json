{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "node", "@testing-library/jest-dom/vitest"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "test", "e2e", "e2e-pwa", "vite.config.ts", "eslint.config.js", "playwright.config.ts", "playwright.pwa.config.ts"]
}
