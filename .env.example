# Copy to .env and fill in. Never commit .env.

# API
APP_ENV=local
LOG_LEVEL=INFO
# The app always switches to the app_rw role per transaction, so RLS applies.
DATABASE_URL=postgresql+asyncpg://healthsaathi:healthsaathi@localhost:5432/healthsaathi
# Used by Alembic and the seed script. Needs CREATEROLE and must be able to create tables.
MIGRATOR_DATABASE_URL=postgresql+asyncpg://healthsaathi:healthsaathi@localhost:5432/healthsaathi
CORS_ORIGINS=["http://localhost:5173"]

# Secrets. `make env` creates .env from this file with random values filled in.
JWT_SECRET=
OTP_HMAC_KEY=
# Comma separated key_id:base64(32 bytes). The first key encrypts new data; keep old keys to read.
DATA_KEYS=
# Seed for the clinic keys that sign Merkle checkpoints. Back it up: losing it means new keys.
LEDGER_SIGNING_SEED=

# Auth
REFRESH_TOKEN_DAYS=14
# Set to .healthsaathi.<domain> in production so app. and api. share the refresh cookie.
COOKIE_DOMAIN=
# Browsers allow Secure cookies on http://localhost, so this stays true in local dev too.
COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true
PUBLIC_APP_URL=http://localhost:5173

# Files. Lab reports go to STORAGE_DIR (default data/blobs) unless an Azure Blob container SAS
# URL is set (production). The SAS needs read, create and write on the lab-docs container only.
STORAGE_DIR=
AZURE_BLOB_CONTAINER_SAS_URL=
MAX_UPLOAD_BYTES=10485760

# Email. "console" logs emails (local dev). "brevo" sends through the Brevo free tier.
EMAIL_BACKEND=console
BREVO_API_KEY=
EMAIL_FROM=no-reply@healthsaathi.test
EMAIL_FROM_NAME=HealthSaathi
# Local and test only: also write emails as JSON files into this folder.
EMAIL_OUTBOX_DIR=

# Local Postgres (docker compose)
POSTGRES_USER=healthsaathi
POSTGRES_PASSWORD=healthsaathi
POSTGRES_DB=healthsaathi
POSTGRES_PORT=5432

# Contracts (only needed to deploy; see make contracts-amoy)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
CUSTOM_RPC_URL=
# Never commit this. Use a wallet that holds only test POL.
DEPLOYER_PRIVATE_KEY=
REGISTRY_ADMIN_1=
REGISTRY_ADMIN_2=
REGISTRY_ADMIN_3=

# Anchoring. Leave a group empty to skip that witness.
# EVM chain (Polygon Amoy, or a local anvil / Besu network).
ANCHOR_RPC_URL=
ANCHOR_CHAIN=amoy
AUDIT_ANCHOR_ADDRESS=
CLINIC_REGISTRY_ADDRESS=
# Never commit this. The poster wallet only needs test POL.
ANCHOR_POSTER_PRIVATE_KEY=
ANCHOR_EXPLORER_URL=https://amoy.polygonscan.com
ANCHOR_TX_TIMEOUT_SECONDS=120
# The GitHub Actions schedule calls the API with this token to run the anchor job.
ANCHOR_TRIGGER_TOKEN=
# The worker runs the anchor job itself if the schedule has not run for this many minutes (0 = off).
ANCHOR_FALLBACK_MINUTES=30
# Public witness repository (owner/name) and a fine-grained token with write access to it only.
WITNESS_REPO=
WITNESS_BRANCH=main
WITNESS_GITHUB_TOKEN=
OTS_ENABLED=false
# JSON list of OpenTimestamps calendars. Leave commented to use the public defaults.
# OTS_CALENDARS=["https://a.pool.opentimestamps.org","https://b.pool.opentimestamps.org"]

# Web
VITE_API_URL=http://localhost:8000
# Receipt verification in the browser reads the chain directly.
VITE_CHAIN_RPC_URL=
VITE_AUDIT_ANCHOR_ADDRESS=
VITE_CLINIC_REGISTRY_ADDRESS=
VITE_EXPLORER_URL=https://amoy.polygonscan.com

# Seed data (make seed). Leave empty to generate a random demo password, printed once.
SEED_DEMO_PASSWORD=

# Prod-demo VM only (infra/docker-compose.prod.yml). Caddy serves the API on this name with HTTPS.
API_DOMAIN=
# Connection the nightly backup uses for pg_dump: the admin (migrator) login in plain
# postgresql:// form, because row level security would hide rows from any other role.
BACKUP_DATABASE_URL=
